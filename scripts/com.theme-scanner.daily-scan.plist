<?xml version="1.0" encoding="UTF-8"?>
<!-- Edit every path below to match wherever this repo lives on your Mac. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.theme-scanner.daily-scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/theme-scanner/scripts/run_after_close.py</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/theme-scanner/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/theme-scanner/logs/launchd.log</string>
</dict>
</plist>
